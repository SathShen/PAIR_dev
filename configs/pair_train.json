{
  "experiment": {
    "name": "PAIR_multidataset_v4",
    "default_datasets": [
      "SECOND"
    ],
    "seed": 42,
    "epochs": 10
  },
  "model": {
    "qwen_model": "/data2/sht/checkpoints/Qwen/Qwen3-VL-4B-Instruct",
    "qwen_tuning": "lora",
    "decoder_dim": 256,
    "lora": {
      "r": 16,
      "alpha": 32,
      "dropout": 0.05,
      "target_modules": [
        "q_proj",
        "k_proj",
        "v_proj",
        "o_proj"
      ]
    },
    "point_encoder": {
      "grid_size": 0.1
    },
    "max_point_reasoning_tokens": 512
  },
  "optimizer": {
    "lr": 0.0001,
    "lora_lr": 2e-05,
    "weight_decay": 0.01,
    "scheduler": "cosine",
    "warmup_ratio": 0.03,
    "max_grad_norm": 1.0
  },
  "training": {
    "grad_accum": 1,
    "num_workers": 4
  },
  "validation": {
    "every_epochs": 1,
    "max_samples": 0,
    "change_threshold": 0.5
  },
  "logging": {
    "log_every": 20,
    "save_every_epochs": 1,
    "tensorboard": true,
    "output_dir": "outputs/pair_multidataset_v4"
  },
  "datasets": {
    "SECOND": {
      "root": "/home/sht/Datasets/SECONDpair",
      "per_gpu_batch_size": 4,
      "class_names": {
        "0": "unchanged",
        "1": "water",
        "2": "ground",
        "3": "low vegetation",
        "4": "tree",
        "5": "building",
        "6": "sports field"
      }
    }
  }
}
